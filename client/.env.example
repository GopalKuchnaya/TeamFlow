# ── TeamFlow web client ─────────────────────────────────────────────────────
# Everything prefixed with VITE_ is embedded in the public JS bundle.
# NEVER put secrets here.

# Base URL of the API. Leave as /api/v1 in development (Vite proxies it to the server).
# In production set the absolute API URL, e.g. https://api.example.com/api/v1
VITE_API_URL=/api/v1

# Dev-server only: where Vite forwards /api requests (not bundled).
# VITE_DEV_API_PROXY=http://localhost:4000
