# ── TeamFlow API configuration ──────────────────────────────────────────────
# Copy to server/.env and adjust. Never commit real secrets.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB connection string (local instance, Docker, or Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/teamflow

# Comma-separated list of browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173

# Number of reverse-proxy hops to trust for client IPs (0 locally, usually 1 behind a load balancer).
TRUST_PROXY=0

# REQUIRED: at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_ISSUER=teamflow-api
JWT_AUDIENCE=teamflow-web
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh-token session lifetime and reuse grace window for parallel tabs.
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_REUSE_GRACE_SECONDS=10

# Refresh cookie attributes. COOKIE_SECURE defaults to true when NODE_ENV=production.
# Use COOKIE_SAMESITE=none (with COOKIE_SECURE=true) only if the SPA and API are on different sites.
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=example.com

RATE_LIMIT_ENABLED=true
